{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. FastAPI Backend (Port 8000)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "uvicorn",
            "args": [
                "src.api.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "API_URL": "http://127.0.0.1:8000",
                "EXTERNAL_API_URL": "http://127.0.0.1:8000"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "2. Streamlit UI (Port 8501)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "streamlit",
            "args": [
                "run",
                "app.py",
                "--server.port",
                "8501"
            ],
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "API_URL": "http://127.0.0.1:8000",
                "EXTERNAL_API_URL": "http://127.0.0.1:8000"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ],
    "compounds": [
        {
            "name": "🚀 Launch Apex-NGS (Full Stack)",
            "configurations": [
                "1. FastAPI Backend (Port 8000)",
                "2. Streamlit UI (Port 8501)"
            ],
            "preLaunchTask": "Start Docker Database",
            "stopAll": true
        }
    ]
}
